# EmailJS Configuration for Portfolio Contact Form
# Get these credentials from your EmailJS dashboard: https://dashboard.emailjs.com/

# 1. EmailJS Service ID (from "Email Services" tab, e.g. service_xxxxxxx)
VITE_EMAILJS_SERVICE_ID=

# 2. EmailJS Template ID (from "Email Templates" tab, e.g. template_xxxxxxx)
VITE_EMAILJS_TEMPLATE_ID=

# 3. EmailJS Public Key (from "Account" > "API Keys" > "Public Key", e.g. xxxxxxxxxxxxxxxx)
VITE_EMAILJS_PUBLIC_KEY=
